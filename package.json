{
  "name": "nexora-team4-incident-rca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["api", "ui"],
  "description": "Team 4 incident management and AI-assisted root cause analysis foundation",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "npm run dev --workspace api",
    "dev:ui": "npm run dev --workspace ui",
    "build": "npm run typecheck && npm run build --workspace api && npm run build --workspace ui",
    "typecheck": "npm run typecheck --workspace api && npm run typecheck --workspace ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace api",
    "test:integration": "npm run test:integration --workspace api",
    "db:generate": "npm run db:generate --workspace api",
    "db:studio": "npm run db:studio --workspace api",
    "start": "npm run start --workspace api"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.29.1"
  }
}
