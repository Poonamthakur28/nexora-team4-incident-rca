{
  "name": "nexora-team4-incident-rca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["ui"],
  "description": "Team 4 incident management and AI-assisted root cause analysis foundation",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "node scripts/run-api.js -m app --reload",
    "dev:ui": "npm run dev --workspace ui",
    "start": "node scripts/run-api.js -m app",
    "build": "npm run typecheck && npm run build --workspace ui",
    "typecheck": "npm run typecheck --workspace ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-api.js -m pytest",
    "test:unit": "node scripts/run-api.js -m pytest tests/unit",
    "test:integration": "node scripts/run-api.js -m pytest tests/integration",
    "db:migrate": "node scripts/run-api.js -m alembic upgrade head",
    "db:current": "node scripts/run-api.js -m alembic current"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.29.1"
  }
}
