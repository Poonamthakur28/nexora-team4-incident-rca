# Copy to .env (repository root) for local development. Never commit .env.
# The API reads this file, then api/.env (which overrides it); real environment variables win over both.

# --- Python API (FastAPI) ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Local Docker Compose defaults only. Use the postgresql+psycopg:// driver prefix.
DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora_team4
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- React UI (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
